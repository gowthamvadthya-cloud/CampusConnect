rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUniversityUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i).*@pondiuni[.]ac[.]in$')
        && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }
    function participant(chatId) {
      return verifiedUniversityUser()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    match /chats/{chatId} {
      allow read: if participant(chatId);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if participant(chatId);
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
